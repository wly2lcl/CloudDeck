    "@clouddeck/sandbox": "workspace:*",
    "@clouddeck/secrets": "workspace:*",
    "@clouddeck/storage": "workspace:*",
    "@clouddeck/worker-llm": "workspace:*",
    "@clouddeck/worker-tts": "workspace:*",
    "@clouddeck/worker-video": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
