{
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "title": "输出前缀",
      "default": "ECHO: "
    },
    "steps": {
      "type": "integer",
      "title": "进度步数",
      "default": 3,
      "minimum": 1,
      "maximum": 20
    },
    "sleepMs": {
      "type": "integer",
      "title": "每步耗时（毫秒）",
      "default": 150,
      "minimum": 0
    },
    "failAtStep": {
      "type": "integer",
      "title": "在第几步失败（0 表示不失败）",
      "default": 0,
      "minimum": 0
    }
  }
}
