FROM node:22-alpine

RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

RUN mkdir -p /data/storage && chown -R node:node /app /data
USER node

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV CONTROL_PLANE_PORT=4310

EXPOSE 4310
CMD ["pnpm", "--filter", "@clouddeck/control-plane", "start"]
