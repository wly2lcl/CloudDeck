FROM node:22-alpine

RUN apk add --no-cache ffmpeg font-noto-cjk
RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

RUN mkdir -p /data/storage /data/workspaces && chown -R node:node /app /data
USER node

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "@clouddeck/job-runner", "start"]
