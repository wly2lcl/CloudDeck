# 复制为 .env 后按需修改
POSTGRES_USER=clouddeck
POSTGRES_PASSWORD=clouddeck
POSTGRES_DB=clouddeck
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=clouddeck
MINIO_ROOT_PASSWORD=clouddeck123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 控制面（本地开发）
CONTROL_PLANE_PORT=4310
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_BASE=http://localhost:4310
DATABASE_URL=postgres://clouddeck:clouddeck@localhost:5432/clouddeck
REDIS_URL=redis://localhost:6379

# 鉴权与会话（生产必须替换）
AUTH_SECRET=dev-secret-change-me
# 全局 API 限流（次/分钟）；登录与公开分享另有更严格的单路由限制
RATE_LIMIT_MAX=300
# 租户模型凭据加密主密钥（生产必须设置为高熵随机值，且独立于 AUTH_SECRET）
CREDENTIALS_KEY=dev-credentials-key-change-me
# 轮换时填写旧主密钥，调用 POST /v1/model-credentials/rotate 后移除
# CREDENTIALS_KEY_PREVIOUS=

# 本地存储（未配置 S3_BUCKET 时使用）
STORAGE_DIR=./.data/storage
STORAGE_LOCAL_SECRET=dev-secret-change-me

# S3 / MinIO（配置 S3_BUCKET 后启用）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=clouddeck
S3_SECRET_KEY=clouddeck123
S3_BUCKET=clouddeck

# 沙箱（M2）
SANDBOX_DRIVER=local
SANDBOX_IMAGE=node:22-alpine
SANDBOX_NETWORK=none
# gVisor：安装 runsc 后设置，并用 pnpm sandbox:check 预检
# SANDBOX_RUNTIME=runsc
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
CAPABILITIES_DIR=./capabilities
# 可续作能力的工作区根目录（生产建议挂持久卷）
WORKSPACE_ROOT=./.data/workspaces

# Claude Code（BYOK）
ANTHROPIC_API_KEY=
# CLAUDE_BIN=claude
# CLAUDE_SKIP_PERMISSIONS=false

# TTS（M3）
# fake：本地确定性 WAV；dashscope/bailian：阿里云百炼；http：兼容的 TTS 服务
TTS_PROVIDER=fake
TTS_MODEL=qwen-audio-3.1-tts-flash
TTS_DEFAULT_VOICE=longanhuan_v3.1
# BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=
# TTS_HTTP_URL=http://localhost:8188/tts
# TTS_HTTP_TOKEN=
TTS_PRICE_PER_1K_USD=0.002
TTS_MAX_ATTEMPTS=4
TTS_RETRY_BASE_MS=500
# TTS_IMAGE=clouddeck/tts:local

# LLM（M4，可选；未配置时使用确定性启发式）
# LLM_HTTP_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_HTTP_TOKEN=
LLM_PRICE_PER_1K_TOKENS=0.002
# 429/5xx 重试
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_MS=500
LLM_TIMEOUT_MS=120000

# 视频（M4）
FFMPEG_BIN=ffmpeg
VIDEO_WIDTH=640
VIDEO_HEIGHT=360
VIDEO_FPS=25

# 支付（对外）；mock 用于内测，http 对接真实网关
PAYMENT_PROVIDER=mock
# PAYMENT_HTTP_URL=https://pay-gateway.example.com/checkout
# PAYMENT_HTTP_TOKEN=
PAYMENT_WEBHOOK_SECRET=dev-payment-secret

# 推送；mock 记录日志，http 对接 FCM/APNs 网关
PUSH_PROVIDER=mock
# PUSH_HTTP_URL=https://push-gateway.example.com/send
# PUSH_HTTP_TOKEN=
