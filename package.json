{
  "name": "clouddeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @clouddeck/control-plane --filter @clouddeck/job-runner --filter @clouddeck/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:boundaries",
    "test:boundaries": "vitest run scripts",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "smoke:llm": "pnpm --filter @clouddeck/worker-llm smoke",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries",
    "format": "prettier --write .",
    "smoke:tts": "pnpm --filter @clouddeck/worker-tts smoke",
    "sandbox:check": "tsx scripts/sandbox-preflight.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
