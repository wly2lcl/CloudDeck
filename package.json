{
  "name": "clouddeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @clouddeck/control-plane --filter @clouddeck/job-runner --filter @clouddeck/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:e2e",
    "test": "vitest run",
    "test:boundaries": "vitest run scripts",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "smoke:llm": "pnpm --filter @clouddeck/worker-llm smoke",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm openapi:check && pnpm k8s:check",
    "format": "prettier --write .",
    "smoke:tts": "pnpm --filter @clouddeck/worker-tts smoke",
    "sandbox:check": "tsx scripts/sandbox-preflight.ts",
    "load:test": "tsx scripts/load-test.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "test:coverage": "vitest run --coverage",
    "build:docs": "tsx scripts/build-docs.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "cleanup:storage": "tsx scripts/cleanup-storage.ts",
    "load:jobs": "tsx scripts/load-jobs.ts",
    "sbom": "tsx scripts/sbom.ts",
    "k8s:check": "tsx scripts/check-k8s.ts",
    "eval:llm": "tsx scripts/eval-llm.ts",
    "smoke:embedding": "tsx scripts/embedding-smoke.ts"
  },
  "devDependencies": {
    "@clouddeck/db": "workspace:*",
    "@clouddeck/storage": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "marked": "^18.2.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "version": "0.1.26",
  "description": "AI content production workbench with pluggable capabilities and a novel → script → storyboard → audiobook → video chain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wly2lcl/CloudDeck.git"
  },
  "homepage": "https://github.com/wly2lcl/CloudDeck#readme",
  "bugs": {
    "url": "https://github.com/wly2lcl/CloudDeck/issues"
  }
}
